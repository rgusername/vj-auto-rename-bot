# Telegram application credentials from https://my.telegram.org
API_ID=123456
API_HASH=replace_with_api_hash

# Telegram command-bot token from @BotFather
BOT_TOKEN=123456789:replace_with_bot_token

# MongoDB connection and database
DB_URI=mongodb+srv://username:password@example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=vjjoinrequetbot

# Comma-separated numeric Telegram admin IDs
ADMINS=123456789

# User account used for channel monitoring. Defaults to the first ID in ADMINS.
SESSION_OWNER_ID=123456789

# Telegram username of the external rename bot, without the leading @
RENAME_BOT_USERNAME=FileRenameBot

# Maximum wait for the external rename bot's response; bounded retries are 1-5
RENAME_RESPONSE_TIMEOUT=300
MAX_RENAME_ATTEMPTS=3

# Optional bot log channel ID (negative Telegram channel ID)
LOG_CHANNEL=-1001234567890
